# Copy to .env and fill in the empty values. .env is git-ignored.
# POSTGRES_PASSWORD and JWT_SECRET are deliberately empty: docker compose refuses
# to start until they are set, so a published placeholder can never be used.
# Generate each value with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# PostgreSQL (used by docker-compose to build DATABASE_URL).
# Use URL-safe characters in the password (letters, digits, - _), as the generator above does.
POSTGRES_USER=expenses
POSTGRES_PASSWORD=
POSTGRES_DB=expenses

# JWT signing secret: at least 32 characters.
JWT_SECRET=
JWT_EXPIRE_MINUTES=60

LOG_LEVEL=INFO
